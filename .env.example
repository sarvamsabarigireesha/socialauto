# ---- Mode ----
MOCK_MODE=true                 # true = demo with fake data; false = real API calls
CRON_SECRET=change-me-to-a-long-random-string

# ---- Public URL of this app (OAuth redirect base — set in production) ----
APP_PUBLIC_URL=

# ---- Meta (Instagram / Facebook / Threads) ----
# Create at https://developers.facebook.com → Other → Business → SocialAuto
# Or paste App ID + Secret in the in-app wizard (Channels → Meta App).
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
META_VERIFY_TOKEN=socialauto-verify-token

# ---- Google / YouTube ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI assistant (optional — app works without it) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Auto-comments ----
AUTO_COMMENT_ENABLED=true
COMMENT_SYNC_WINDOW_DAYS=7      # never ingest / keep comments older than this
COMMENT_WATCH_WINDOW_HOURS=24   # auto-reply only on posts published in this window

# ---- Database ----
# Local demo (default): SQLite file
# DATABASE_URL=sqlite:///./data/app.db
#
# Production: Neon Postgres (free 0.5GB) — from the Neon "Connect" dialog:
# postgresql://neondb_owner:xxxx@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
