# ---- Mode ----
MOCK_MODE=true                 # true = demo with fake data; false = real API calls
CRON_SECRET=change-me-to-a-long-random-string

# ---- Security (REQUIRED when MOCK_MODE=false) ----
# Signs login tokens. If this stays at the dev default, anyone can forge a
# login for any account. Generate one:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-too

# ---- Public URL of this app (OAuth redirect base — set in production) ----
APP_PUBLIC_URL=

# ---- Meta (Instagram / Facebook / Threads) ----
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_VERIFY_TOKEN=socialauto-verify-token

# Test-only: a long-lived Page token used by `live_check.py --direct` so a real
# publish can be verified without going through the OAuth redirect flow.
META_ACCESS_TOKEN=

# ---- Google / YouTube ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Test-only (same idea as META_ACCESS_TOKEN): a short-lived Google access token,
# e.g. from the OAuth 2.0 Playground.
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=

# YouTube has no "publish from URL" endpoint — an upload means POSTing the video
# bytes. Off by default so a scheduled post never uploads a file unexpectedly.
# Note: 1 upload = 1,600 of your 10,000 daily quota units (~6 uploads/day).
YOUTUBE_AUTO_UPLOAD=false
YOUTUBE_PRIVACY_STATUS=private   # private | unlisted | public

# ---- AI assistant (optional — app works without it) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Auto-comments ----
AUTO_COMMENT_ENABLED=true
COMMENT_WATCH_WINDOW_HOURS=24

# ---- Database ----
# Local demo (default): SQLite file
# DATABASE_URL=sqlite:///./data/app.db
#
# Production: Neon Postgres (free 0.5GB) — from the Neon "Connect" dialog:
# postgresql://neondb_owner:xxxx@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
