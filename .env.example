# ---- Mode ----
MOCK_MODE=true                 # true = demo with fake data; false = real API calls
CRON_SECRET=change-me-to-a-long-random-string

# ---- Meta (Instagram / Facebook) ----
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# ---- X (Twitter) ----
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ---- LinkedIn ----
LINKEDIN_ACCESS_TOKEN=

# ---- Auto-comments ----
AUTO_COMMENT_ENABLED=true
COMMENT_WATCH_WINDOW_HOURS=24

# ---- Database (default SQLite; use Turso/Neon in prod) ----
# DATABASE_URL=sqlite:///./data/app.db
