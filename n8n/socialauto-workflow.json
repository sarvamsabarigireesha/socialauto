{
  "name": "SocialAuto — scheduler + auto-comments (self-hosted n8n, free)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 15 }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_URL }}/api/cron/tick",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Cron-Secret", "value": "={{ $env.CRON_SECRET }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": { "timeout": 60000 }
      },
      "id": "http-tick",
      "name": "POST /api/cron/tick (publish + auto-reply + analytics)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meta-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-comment",
      "name": "Meta webhook: new comment",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 560],
      "webhookId": "socialauto-meta-comment"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.body.entry[0].changes[0].value.id }}/replies",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "message", "value": "Thanks for your comment! 🙌 Check DMs for details." },
            { "name": "access_token", "value": "={{ $env.META_PAGE_ACCESS_TOKEN }}" }
          ]
        },
        "options": {}
      },
      "id": "reply-node",
      "name": "Reply to comment (Graph API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 560]
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [[{ "node": "POST /api/cron/tick (publish + auto-reply + analytics)", "type": "main", "index": 0 }]]
    },
    "Meta webhook: new comment": {
      "main": [[{ "node": "Reply to comment (Graph API)", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": true
}
